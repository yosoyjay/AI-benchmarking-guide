{
    "HBMBandwidth": {
        "inputs": {
            "num_runs": 5,
            "interval": 10
        }
    },

    "CPUStream": {
        "inputs": {
            "num_runs": 4,
            "interval": 4
        }
    },

    "GEMMCublasLt": {
        "datatype": "fp8e4m3"
    },
    
    "LLMBenchmark": {
        "models": {
            "meta-llama/Llama-3.1-8B":{
                "use_model": true,
                "type": "nvidia",
                "input_sizes": [128, 128, 128, 500, 1024, 2048],
                "output_sizes": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_size": 1,
                "num_requests": 1000,
                "precision": "FP8"
            },

            "meta-llama/Llama-3.1-70B":{
                "use_model": false,
                "type": "nvidia",
                "input_sizes": [128, 128, 128, 500, 1024, 2048],
                "output_sizes": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_size": 8,
                "num_requests": 1000,
                "precision": "FP8"
            },

            "meta-llama/Llama-3.1-405B":{
                "use_model": false,
                "type": "nvidia",
                "input_sizes": [128, 128, 128, 500, 1024, 2048],
                "output_sizes": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_size": 8,
                "num_requests": 1000,
                "precision": "FP8"
            },

            "Meta-Llama-3.1-8B-Instruct-FP8-KV":{
                "use_model": true,
                "type": "amd",
                "max_num_seqs": [3000],
                "input_length":[128, 128, 128, 500, 1024, 2048],
                "output_length": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_sizes": [1],
                "num_requests": [1000]
            },

            "Meta-Llama-3.1-70B-Instruct-FP8-KV":{
                "use_model": false,
                "type": "amd",
                "max_num_seqs": [3000],
                "input_length":[128, 128, 128, 500, 1024, 2048],
                "output_length": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_sizes": [8],
                "num_requests": [1000]
            },

            "Meta-Llama-3.1-405B-Instruct-FP8-KV":{
                "use_model": false,
                "type": "amd",
                "max_num_seqs": [3000],
                "input_length":[128, 128, 128, 500, 1024, 2048],
                "output_length": [128, 1024, 2048, 2000, 1024, 2048],
                "tp_sizes": [8],
                "num_requests": [1000]
            }
        }
    },
    
    "FIO": {
        "tests": [
            ["read", "1M"], ["read", "512k"], ["read", "1k"],
            ["write", "1M"], ["write", "512k"], ["write", "1k"],
            ["randwrite", "1k"], ["randread", "1k"]
        ],
        "runtime": 300,
        "numjobs": 4,
        "size": "10G",
        "iodepth": 255,
        "ioengine": "libaio",
        "direct": 1
    },

    "NCCLBandwidth": {
        "begin_size": "8",
        "end_size": "8G",
        "factor": "2",
        "num_iters": "40"
    },

    "NVBandwidth": {
        "test_names": [
            "device_to_host_memcpy_ce",
            "host_to_device_memcpy_ce",
            "device_to_device_bidirectional_memcpy_read_ce"
        ]
    },

    "Multichase": {
        "stride": "512",
        "memory": "1g",
        "iterations": "120"
    },

    "GEMMHipBLAS": {
        "m_dims": [1024, 2048, 4096, 8192, 16384, 32768, 1024, 6144, 802816],
        "n_dims": [1024, 2048, 4096, 8192, 16384, 32768, 2145, 12288, 192],
        "k_dims": [1024, 2048, 4096, 8192, 16384, 32768, 1024, 12288, 768],
        "datatype": "FP8",
        "warmup": 10000,
        "iters": 2000,
        "cold_iters": 100
    },

    "RCCLBandwidth": {
        "algorithms": ["Tree", "Ring", "NVLS", "NVLSTree"],
        "begin_size": "8",
        "end_size": "8G",
        "factor": "2",
        "num_gpus": "8",
        "num_iters": "40"
    },

    "TransferBench": {
        "config_file": "benchmarks/amd/transferbench.cfg"
    },

    "LLAMA3Pretraining": {
        "mount_path": ".",
        "training_script": "benchmarks/nvidia/llama3_recipe.py",
        "docker_image": "nvcr.io/nvidia/nemo:25.04",
        "model": {
            "H200": {
                "3b": {
                    "micro_batch_size": 8,
                    "precision": "fp16",
                    "parallelism": {
                        "tp": 1,
                        "pp": 1,
                        "vp": null,
                        "cp": 2
                    }
                },
                "8b": {
                    "micro_batch_size": 2,
                    "precision": "bf16",
                    "parallelism": {
                        "tp": 1,
                        "pp": 1,
                        "vp": null,
                        "cp": 1
                    }
                }
            },
            "GB200": {
                "3b": {
                    "micro_batch_size": 4,
                    "precision": "fp16",
                    "parallelism": {
                        "tp": 1,
                        "pp": 1,
                        "vp": null,
                        "cp": 1
                    }
                },
                "8b": {
                    "micro_batch_size": 4,
                    "precision": "bf16",
                    "parallelism": {
                        "tp": 1,
                        "pp": 2,
                        "vp": null,
                        "cp": 1
                    }
                }
            }
        }
    }
}
